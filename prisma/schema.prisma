generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  businessName  String
  businessType  BusinessType @default(OTHER)
  plan          SubscriptionPlan @default(STARTER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sales         Sale[]
  alerts        Alert[]
  insights      Insight[]
  products      Product[]
  customers     Customer[]
  sessions      Session[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Product {
  id          String   @id @default(cuid())
  userId      String
  name        String
  sku         String
  category    String
  price       Float
  cost        Float
  quantity    Int      @default(0)
  reorderPoint Int     @default(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  saleItems   SaleItem[]

  @@unique([userId, sku])
  @@map("products")
}

model Customer {
  id          String   @id @default(cuid())
  userId      String
  name        String?
  email       String?
  phone       String?
  totalSpent  Float    @default(0)
  visitCount  Int      @default(0)
  lastVisit   DateTime @default(now())
  segment     CustomerSegment @default(NEW)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales       Sale[]

  @@map("customers")
}

model Sale {
  id              String   @id @default(cuid())
  userId          String
  customerId      String?
  totalAmount     Float
  paymentMethod   String   @default("card")
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer        Customer? @relation(fields: [customerId], references: [id])
  items           SaleItem[]

  @@map("sales")
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  productId   String
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@map("sale_items")
}

model Alert {
  id          String   @id @default(cuid())
  userId      String
  type        AlertType
  severity    AlertSeverity @default(INFO)
  title       String
  message     String
  insight     String?
  read        Boolean  @default(false)
  actionUrl   String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("alerts")
}

model Insight {
  id              String   @id @default(cuid())
  userId          String
  type            InsightType
  title           String
  summary         String
  details         String   @db.Text
  recommendations String[]
  confidence      Float
  dataPoints      Json
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("insights")
}

model DailyMetrics {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime @db.Date
  totalRevenue    Float    @default(0)
  transactionCount Int     @default(0)
  averageTicket   Float    @default(0)
  customerCount   Int      @default(0)
  topProducts     Json     @default("[]")
  createdAt       DateTime @default(now())

  @@unique([userId, date])
  @@map("daily_metrics")
}

enum BusinessType {
  COFFEE_SHOP
  BOUTIQUE
  CONVENIENCE_STORE
  RESTAURANT
  OTHER
}

enum SubscriptionPlan {
  STARTER
  GROWTH
  PROFESSIONAL
  ENTERPRISE
}

enum AlertType {
  ANOMALY
  OPPORTUNITY
  TREND
  INVENTORY
  PERFORMANCE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
  SUCCESS
}

enum InsightType {
  TREND
  ANOMALY
  FORECAST
  RECOMMENDATION
  COMPARISON
}

enum CustomerSegment {
  NEW
  REGULAR
  VIP
  AT_RISK
  CHURNED
}
